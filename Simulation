      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.special import ellipk, ellipe\n",
        "\n",
        "# --- 1. Magnetic Bottle Field (Two Coils) ---\n",
        "def single_loop_bfield(x, y, z, z0, R, I):\n",
        "    mu0 = 4 * np.pi * 1e-7\n",
        "    rho = np.sqrt(x**2 + y**2)\n",
        "    z_rel = z - z0\n",
        "    if rho < 1e-10:\n",
        "        return np.array([0.0, 0.0, (mu0 * I * R**2) / (2 * (R**2 + z_rel**2)**1.5)])\n",
        "    alpha2 = R**2 + rho**2 + z_rel**2 - 2 * R * rho\n",
        "    beta2 = R**2 + rho**2 + z_rel**2 + 2 * R * rho\n",
        "    beta = np.sqrt(beta2)\n",
        "    k2 = 1.0 - (alpha2 / beta2)\n",
        "    K, E = ellipk(k2), ellipe(k2)\n",
        "    C = mu0 * I / np.pi\n",
        "    Brho = (C * z_rel / (2 * alpha2 * beta * rho)) * ((R**2 + rho**2 + z_rel**2) * E - alpha2 * K)\n",
        "    Bz = (C / (2 * alpha2 * beta)) * ((R**2 - rho**2 - z_rel**2) * E + alpha2 * K)\n",
        "    return np.array([Brho * (x / rho), Brho * (y / rho), Bz])\n",
        "\n",
        "def bottle_bfield(pos, coil_z=1.0, R=0.5, I=5e4):\n",
        "    return (single_loop_bfield(*pos, -coil_z, R, I) +\n",
        "            single_loop_bfield(*pos, +coil_z, R, I))\n",
        "\n",
        "# --- 2. Boris Pusher Integrator ---\n",
        "def simulate_particle(alpha_deg, v0=2.5e5, steps=100000, dt=1e-9):\n",
        "    q, m = 1.602e-19, 1.672e-27\n",
        "    alpha = np.radians(alpha_deg)\n",
        "\n",
        "    pos = np.array([0.05, 0.0, 0.0])\n",
        "    vel = np.array([0.0, v0 * np.sin(alpha), v0 * np.cos(alpha)])\n",
        "\n",
        "    traj = np.zeros((steps, 3))\n",
        "    mu_history = np.zeros(steps)\n",
        "\n",
        "    for i in range(steps):\n",
        "        traj[i] = pos\n",
        "        B = bottle_bfield(pos)\n",
        "        B_mag = np.linalg.norm(B)\n",
        "        b_hat = B / B_mag\n",
        "\n",
        "        # Calculate perpendicular kinetic energy & adiabatic invariant mu\n",
        "        v_par = np.dot(vel, b_hat)\n",
        "        v_perp2 = np.dot(vel, vel) - v_par**2\n",
        "        mu_history[i] = (0.5 * m * v_perp2) / B_mag\n",
        "\n",
        "        # Boris step\n",
        "        t = (q * dt / (2 * m)) * B\n",
        "        s = (2 * t) / (1 + np.dot(t, t))\n",
        "        v_prime = vel + np.cross(vel, t)\n",
        "        vel = vel + np.cross(v_prime, s)\n",
        "        pos = pos + vel * dt\n",
        "\n",
        "    return traj, mu_history\n",
        "\n",
        "# Calculate theoretical loss cone angle on axis\n",
        "B0 = np.linalg.norm(bottle_bfield([0, 0, 0]))\n",
        "Bmax = np.linalg.norm(bottle_bfield([0, 0, 1.0]))\n",
        "loss_cone_deg = np.degrees(np.arcsin(np.sqrt(B0 / Bmax)))\n",
        "print(f\"Mirror Ratio (Bmax/B0): {Bmax/B0:.2f} | Critical Loss Cone Angle: {loss_cone_deg:.1f}°\")\n",
        "\n",
        "# Simulate one TRAPPED particle (alpha > loss cone) and one ESCAPING particle (alpha < loss cone)\n",
        "traj_trapped, mu_trapped = simulate_particle(alpha_deg=55.0)\n",
        "traj_escaped, mu_escaped = simulate_particle(alpha_deg=25.0, steps=25000)\n",
        "\n",
        "# --- 3. Plot Results ---\n",
        "fig = plt.figure(figsize=(14, 6))\n",
        "\n",
        "# Left Panel: 3D Comparison\n",
        "ax1 = fig.add_subplot(121, projection='3d')\n",
        "ax1.plot(traj_trapped[:, 0], traj_trapped[:, 1], traj_trapped[:, 2], color='#1f77b4', lw=0.8, label='Trapped ($\\\\alpha_0 = 55^\\\\circ$)')\n",
        "ax1.plot(traj_escaped[:, 0], traj_escaped[:, 1], traj_escaped[:, 2], color='#ff7f0e', lw=1.2, label='Escaped / Loss Cone ($\\\\alpha_0 = 25^\\\\circ$)')\n",
        "\n",
        "theta = np.linspace(0, 2*np.pi, 100)\n",
        "for zc in [-1.0, 1.0]:\n",
        "    ax1.plot(0.5*np.cos(theta), 0.5*np.sin(theta), np.full_like(theta, zc), color='crimson', lw=2.5)\n",
        "ax1.set_title('Magnetic Mirroring vs. Loss Cone Escape')\n",
        "ax1.set_xlabel('X (m)'); ax1.set_ylabel('Y (m)'); ax1.set_zlabel('Z (m)')\n",
        "ax1.set_zlim(-1.5, 1.5)\n",
        "ax1.legend()\n",
        "\n",
        "# Right Panel: Adiabatic Invariance Verification\n",
        "ax2 = fig.add_subplot(122)\n",
        "time_us = np.arange(len(mu_trapped)) * 1e-3  # microseconds\n",
        "ax2.plot(time_us, mu_trapped / mu_trapped[0], color='#2ca02c', lw=1.2)\n",
        "ax2.axhline(1.0, color='black', linestyle='--', lw=1, label='Ideal Conservation ($\\\\mu / \\\\mu_0 = 1$)')\n",
        "ax2.set_ylim(0.95, 1.05)\n",
        "ax2.set_title('First Adiabatic Invariant Conservation ($\\\\mu = mv_\\\\perp^2 / 2B$)')\n",
        "ax2.set_xlabel('Time ($\\\\mu$s)')\n",
        "ax2.set_ylabel('Normalized Magnetic Moment ($\\\\mu / \\\\mu_0$)')\n",
        "ax2.grid(True, alpha=0.3)\n",
        "ax2.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('mirror_vs_losscone.png', dpi=300)\n",
        "plt.show()\n"
